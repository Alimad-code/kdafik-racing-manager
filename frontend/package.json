{
  "name": "kdafik-racing-manager",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "test:preview": "vite preview",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "format": "prettier --write --ignore-unknown \"*.{js,ts,json,md,html}\" \"src/**/*.{ts,tsx,css}\" \"tests/**/*.ts\" \"docs/**/*.md\" \".skills/**/*.md\" \"public/**/*.{svg,html,json}\"",
    "format:check": "prettier --check --ignore-unknown \"*.{js,ts,json,md,html}\" \"src/**/*.{ts,tsx,css}\" \"tests/**/*.ts\" \"docs/**/*.md\" \".skills/**/*.md\" \"public/**/*.{svg,html,json}\"",
    "test:e2e": "playwright test",
    "test:production-edge": "node scripts/verify-production-edge.mjs"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^5.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.0.0",
    "tailwind-merge": "^2.5.5",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^3.24.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@playwright/test": "^1.49.0",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.1",
    "@types/react-dom": "^19.0.2",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.16",
    "globals": "^15.14.0",
    "postcss": "^8.4.49",
    "prettier": "^3.4.2",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.7.2",
    "typescript-eslint": "^8.18.1",
    "vite": "^6.0.5"
  }
}
