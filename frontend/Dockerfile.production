FROM node:22.18.0-alpine3.22 AS build

WORKDIR /build
COPY package.json package-lock.json ./
RUN npm ci
COPY . ./
RUN npm run build

FROM nginx:1.28.0-alpine AS runtime

COPY nginx.production.conf.template /etc/nginx/kdafik/nginx.production.conf.template
COPY nginx/includes/backend-proxy.conf /etc/nginx/includes/backend-proxy.conf
COPY --chmod=0555 docker-entrypoint.production.sh /usr/local/bin/kdafik-edge-entrypoint
RUN rm -f /etc/nginx/conf.d/default.conf \
    && mkdir -p /etc/nginx/kdafik /etc/nginx/includes /var/cache/nginx/client_temp /var/cache/nginx/proxy_temp /var/run/nginx \
    && chown -R nginx:nginx /var/cache/nginx /var/run/nginx /usr/share/nginx/html
COPY --from=build --chown=nginx:nginx /build/dist /usr/share/nginx/html

# The process listens on unprivileged container ports and can safely run as nginx (UID 101).
# TLS key files mounted from deploy/tls/local or deploy/tls/production must be readable by this UID and unavailable to others.
USER nginx
EXPOSE 8080 8443
CMD ["/usr/local/bin/kdafik-edge-entrypoint"]
