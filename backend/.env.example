ENVIRONMENT=local
DEBUG=false
DATABASE_URL=postgresql+psycopg://kdafik:<local-postgres-password>@db:5432/kdafik_racing_manager
CORS_ORIGINS=https://kdafik.localhost
TRUSTED_HOSTS=kdafik.localhost,backend
AUTH_JWT_SECRET=<generate-a-local-random-secret-of-at-least-32-characters>
AUTH_JWT_ISSUER=kdafik-racing-manager
AUTH_JWT_AUDIENCE=kdafik-racing-manager-api
REFRESH_COOKIE_NAME=kdafik_refresh_token
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30
REFRESH_COOKIE_SECURE=true
REFRESH_COOKIE_SAMESITE=lax
LLM_ENABLED=false

EMAIL_ENABLED=false
# Required when EMAIL_ENABLED=true. Use a local-only random value (>=32 characters).
EMAIL_CODE_SECRET=local-only-email-code-secret-change-before-public-use
EMAIL_FROM_ADDRESS=Kdafik Racing Manager <kdafikracing@yandex.ru>
SMTP_HOST=smtp.yandex.ru
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
