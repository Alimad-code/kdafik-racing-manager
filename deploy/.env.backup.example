# This file is read only by the one-shot PostgreSQL backup container.
# Copy it to deploy/.env.backup on the VDS and use chmod 600. Never commit it.
S3_BUCKET=<your-private-selectel-bucket-name>
S3_REGION=ru-7
S3_ENDPOINT=s3.ru-7.storage.selcloud.ru
S3_ACCESS_KEY_ID=<selectel-s3-access-key>
S3_SECRET_ACCESS_KEY=<selectel-s3-secret-key>
BACKUP_RETENTION_DAYS=30
