ENVIRONMENT=production
PUBLIC_HOST=<domain.example.ru>
DEBUG=false
DATABASE_URL=postgresql+psycopg://kdafik_app:<database-password>@<managed-postgresql-host>:5432/kdafik_racing_manager?sslmode=require
AUTH_JWT_SECRET=<generate-a-random-secret-of-at-least-32-characters>
AUTH_JWT_ISSUER=kdafik-racing-manager
AUTH_JWT_AUDIENCE=kdafik-racing-manager-api
ACCESS_TOKEN_MINUTES=60
REFRESH_TOKEN_DAYS=30
REFRESH_COOKIE_NAME=kdafik_refresh_token
REFRESH_COOKIE_SECURE=true
REFRESH_COOKIE_SAMESITE=lax
CORS_ORIGINS=https://<domain.example.ru>
TRUSTED_HOSTS=<domain.example.ru>

EMAIL_ENABLED=true
FRONTEND_PUBLIC_BASE_URL=https://<domain.example.ru>
EMAIL_FROM_ADDRESS=Kdafik Racing Manager <kdafikracing@yandex.ru>
SMTP_HOST=smtp.yandex.ru
SMTP_PORT=587
SMTP_USERNAME=<yandex-mailbox-login>
SMTP_PASSWORD=<smtp-password>
SMTP_USE_TLS=true
