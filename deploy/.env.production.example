ENVIRONMENT=production
PUBLIC_HOST=<domain.example.ru>
DEBUG=false
POSTGRES_PASSWORD=<generate-a-random-database-password>
DATABASE_URL=postgresql+psycopg://kdafik:${POSTGRES_PASSWORD}@db:5432/kdafik_racing_manager
AUTH_JWT_SECRET=<generate-a-random-secret-of-at-least-32-characters>
AUTH_JWT_ISSUER=kdafik-racing-manager
AUTH_JWT_AUDIENCE=kdafik-racing-manager-api
ACCESS_TOKEN_MINUTES=60
REFRESH_TOKEN_DAYS=30
REFRESH_COOKIE_NAME=kdafik_refresh_token
REFRESH_COOKIE_SECURE=true
REFRESH_COOKIE_SAMESITE=lax
CORS_ORIGINS=https://<domain.example.ru>
TRUSTED_HOSTS=<domain.example.ru>

EMAIL_ENABLED=true
# Required: a unique random secret of at least 32 characters. Never use this placeholder.
EMAIL_CODE_SECRET=<generate-a-unique-random-secret-of-at-least-32-characters>
EMAIL_FROM_ADDRESS=Kdafik Racing Manager <no-reply@kdafik-racing.ru>
SMTP_HOST=smtp.mail.selcloud.ru
SMTP_PORT=1127
SMTP_USERNAME=<selectel-mail-login>
SMTP_PASSWORD=<selectel-mail-password>
SMTP_USE_TLS=false
SMTP_USE_SSL=true
LLM_ENABLED=false
