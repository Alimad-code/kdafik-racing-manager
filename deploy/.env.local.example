ENVIRONMENT=local
PUBLIC_HOST=kdafik.localhost
DEBUG=false
POSTGRES_PASSWORD=change-this-local-postgres-password
DATABASE_URL=postgresql+psycopg://kdafik:change-this-local-postgres-password@db:5432/kdafik_racing_manager
AUTH_JWT_SECRET=change-this-local-jwt-secret-to-a-random-value-of-at-least-32-characters
AUTH_JWT_ISSUER=kdafik-racing-manager
AUTH_JWT_AUDIENCE=kdafik-racing-manager-api
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30
REFRESH_COOKIE_NAME=kdafik_refresh_token
REFRESH_COOKIE_SECURE=false
REFRESH_COOKIE_SAMESITE=lax
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://kdafik.localhost
TRUSTED_HOSTS=localhost,127.0.0.1,kdafik.localhost,backend

EMAIL_ENABLED=false
FRONTEND_PUBLIC_BASE_URL=http://localhost:5173
EMAIL_FROM_ADDRESS=Kdafik Racing Manager <kdafikracing@yandex.ru>
SMTP_HOST=smtp.yandex.ru
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
